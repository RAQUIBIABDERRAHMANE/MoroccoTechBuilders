# ==============================================================================
# Morocco Tech Builders - Example Environment Variables
# ==============================================================================

# Webhook URL for registration forwarding (e.g., n8n, Make, Zapier, custom API)
EVENT_WEBHOOK_URL=http://localhost:5678/webhook/event-qr
N8N_WEBHOOK_URL=http://localhost:5678/webhook/event-qr

# Scan & Access control webhook (Day of Event)
EVENT_SCAN_WEBHOOK_URL=http://localhost:5678/webhook/event-qr-scan
N8N_SCAN_WEBHOOK_URL=http://localhost:5678/webhook/event-qr-scan

# Security PIN for /scan entrance scanner
NEXT_PUBLIC_SCAN_PIN=2126
ADMIN_PIN=2126

# Security Secrets
SESSION_SECRET=your-strong-random-session-secret-here
SCAN_API_SECRET=your-scan-api-secret-here

# Public URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Wallet API (Issuer ID & Service Account Key)
GOOGLE_WALLET_ISSUER_ID=3388000000023194470
# Production: Paste the base64 encoded string of your service-account.json:
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=
# Alternative format:
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=google-wallet-pass@...iam.gserviceaccount.com
# GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
